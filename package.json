{
  "name": "blueprint-architect-plugin-repository",
  "version": "0.1.0",
  "private": true,
  "description": "Development and validation tooling for the Blueprint Architect Codex Plugin.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test tests/resources.test.ts tests/interaction-contract.test.ts tests/generate-structure.test.ts tests/search-github.test.ts",
    "typecheck": "node --experimental-strip-types --check plugins/blueprint-architect-plugin/skills/blueprint-architect/scripts/generate-structure.ts && node --experimental-strip-types --check plugins/blueprint-architect-plugin/skills/blueprint-architect/scripts/search-github.ts",
    "validate:skill": "node scripts/validate-release.mjs skill",
    "validate:plugin": "node scripts/validate-release.mjs plugin",
    "validate": "npm run typecheck && npm test && npm run validate:skill && npm run validate:plugin"
  }
}
